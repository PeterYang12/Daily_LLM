[Unit]
Description=Benchmark Jupyter Server
Wants=code-interpreter.service
StartLimitBurst=0

[Service]
Type=simple
WorkingDirectory=/home/user
Environment=PATH=/opt/benchmark-ci/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/benchmark-ci/bin/jupyter server --IdentityProvider.token=""
ExecStartPost=-/usr/bin/systemctl reset-failed code-interpreter
Restart=on-failure
RestartSec=1
StandardOutput=null
StandardError=journal
