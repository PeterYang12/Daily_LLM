  "definitions": {
    "startup": "Runner episode span entry through first model_roundtrip begin, including shared admission, retries, sandbox/repository setup and initial toolbox initialization. Untraced intervals inside this envelope are separately reported.",
    "model_roundtrip": "Union of client model query spans; includes model/backend queueing, generation and transport, not pure GPU generation.",
    "logical_tool": "Union of high-level tool spans after the first model query, including nested exec gate waiting, SDK command execution, file operations and polling. The native initial cwd call before the first model query is allocated to startup, not double-counted here.",
    "verifier": "Union of verifier spans; includes script upload, gate waiting, tests and result parsing.",
    "cleanup": "Union of toolbox_close and sdk_kill after first model call; startup rollback cleanup remains in startup.",
    "unattributed": "Episode time outside these nonoverlapping categories; it is not silently assigned to model or tools.",
    "tail_mapping": "Global rank-244 host wall timestamp mapped onto each runner monotonic axis at its episode begin; wall/monotonic residuals are recorded.",
    "parallel_totals": "Sums across runners are cumulative runner-seconds, not elapsed batch wall time."
