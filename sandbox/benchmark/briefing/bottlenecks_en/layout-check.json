      "width_pt": 54.34658203125,
      "box_width_pt": 248.4,
      "required_height_pt": 12.154,
      "box_height_pt": 14.4
    },
    {
      "text": "Recreate a sandbox for every\none-line Python action: setup is\npaid every time.",
      "size": 14.0,
      "lines": 3,
      "width_pt": 220.8486328125,
      "box_width_pt": 248.4,
      "required_height_pt": 49.559999999999995,
      "box_height_pt": 67.67999999999999
    },
    {
      "text": "Inspect: readiness, first-use and reset time.",
