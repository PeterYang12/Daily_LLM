[Unit]
Description=Monitor E2B health, VM/Kubernetes, capacity, and sandbox lifecycle
After=network-online.target

[Service]
Type=oneshot
User=15341
Group=15341
UMask=0077
WorkingDirectory=/data2/yuhanya/e2b-local-20260916
ExecStart=/data2/yuhanya/e2b-local-20260916/client-env/bin/python -B /data2/yuhanya/e2b-local-20260916/code/monitor_service.py --passive
TimeoutStartSec=110
MemoryMax=1G
CPUQuota=100%
TasksMax=512
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
