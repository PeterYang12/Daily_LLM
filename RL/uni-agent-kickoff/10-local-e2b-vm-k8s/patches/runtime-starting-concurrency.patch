+// maxStartingInstancesPerNodeFallback provides a local start/resume concurrency
+// setting. A configured LaunchDarkly flag still takes precedence.
+func maxStartingInstancesPerNodeFallback() int {
+	raw, set := os.LookupEnv("E2B_MAX_STARTING_INSTANCES_PER_NODE")
+	if !set {
+		return 3
+	}
+
+	limit, err := strconv.Atoi(raw)
+	if err != nil || limit <= 0 {
+		panic(fmt.Sprintf("E2B_MAX_STARTING_INSTANCES_PER_NODE must be a positive integer, got %q", raw))
+	}
+
+	return limit
+}
