diff --git a/packages/shared/pkg/fcversion/host_policy.go b/packages/shared/pkg/fcversion/host_policy.go
new file mode 100644
index 0000000..cbf0971
--- /dev/null
+++ b/packages/shared/pkg/fcversion/host_policy.go
@@ -0,0 +1,41 @@
+package fcversion
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+)
+
+// SandboxHugePagesEnv selects the deployment's guest-memory policy. Set it
+// consistently on the API, orchestrator, and template-manager processes.
+const SandboxHugePagesEnv = "E2B_SANDBOX_HUGE_PAGES"
+
+// SandboxHugePagesEnabled defaults to the upstream hugepage policy when the
+// variable is absent. An explicitly empty or malformed value is an error, so a
+// typo cannot silently enable HugeTLB on a host without a reserved pool.
+func SandboxHugePagesEnabled() (bool, error) {
+	value, set := os.LookupEnv(SandboxHugePagesEnv)
+	if !set {
+		return true, nil
+	}
+
+	enabled, err := strconv.ParseBool(value)
+	if err != nil {
+		return false, fmt.Errorf("invalid %s %q: %w", SandboxHugePagesEnv, value, err)
+	}
+
+	return enabled, nil
+}
+
+// UseHugePages combines the deployment's policy with the binary's capability.
+// It configures newly booted VMs; restoring a memory snapshot retains the page
+// type recorded by Firecracker, so existing HugeTLB templates must be rebuilt
+// before removing the host's hugepage pool.
+func (v *Info) UseHugePages() (bool, error) {
+	enabled, err := SandboxHugePagesEnabled()
+	if err != nil {
+		return false, err
+	}
+
+	return enabled && v.HasHugePages(), nil
+}
diff --git a/packages/shared/pkg/fcversion/host_policy_test.go b/packages/shared/pkg/fcversion/host_policy_test.go
new file mode 100644
index 0000000..2935c5b
--- /dev/null
+++ b/packages/shared/pkg/fcversion/host_policy_test.go
@@ -0,0 +1,77 @@
+package fcversion
+
+import (
+	"os"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSandboxHugePagesPolicy(t *testing.T) {
+	cases := []struct {
+		name    string
+		value   string
+		unset   bool
+		enabled bool
+		invalid bool
+	}{
+		{name: "default", unset: true, enabled: true},
+		{name: "enabled", value: "true", enabled: true},
+		{name: "disabled", value: "false"},
+		{name: "one", value: "1", enabled: true},
+		{name: "zero", value: "0"},
+		{name: "uppercase", value: "FALSE"},
+		{name: "empty", value: "", invalid: true},
+		{name: "invalid", value: "disabled", invalid: true},
+		{name: "whitespace", value: " false ", invalid: true},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv(SandboxHugePagesEnv, tc.value)
+			if tc.unset {
+				require.NoError(t, os.Unsetenv(SandboxHugePagesEnv))
+			}
+
+			enabled, err := SandboxHugePagesEnabled()
+			if tc.invalid {
+				require.ErrorContains(t, err, SandboxHugePagesEnv)
+				assert.False(t, enabled)
+			} else {
+				require.NoError(t, err)
+				assert.Equal(t, tc.enabled, enabled)
+			}
+
+			for _, version := range []string{"v1.6.0", "v1.7.0", "v1.14.1_431f1fc", "v1.14-0.2.0"} {
+				info, err := New(version)
+				require.NoError(t, err)
+				capability := info.HasHugePages()
+				useHugePages, err := info.UseHugePages()
+				if tc.invalid {
+					require.ErrorContains(t, err, SandboxHugePagesEnv, version)
+					assert.False(t, useHugePages, version)
+				} else {
+					require.NoError(t, err, version)
+					assert.Equal(t, tc.enabled && capability, useHugePages, version)
+				}
+				assert.Equal(t, capability, info.HasHugePages(), "policy must not alter capability")
+			}
+		})
+	}
+}
+
+func TestOrdinaryPagesKeepOtherFirecrackerCapabilities(t *testing.T) {
+	t.Setenv(SandboxHugePagesEnv, "false")
+	info, err := New("v1.14-0.2.0")
+	require.NoError(t, err)
+
+	useHugePages, err := info.UseHugePages()
+	require.NoError(t, err)
+	assert.False(t, useHugePages)
+	assert.True(t, info.HasHugePages())
+	assert.True(t, info.HasMemfd())
+	assert.True(t, info.HasFreePageReporting())
+	assert.True(t, info.HasFreePageHinting())
+	assert.True(t, info.HasInPlaceCheckpoint())
+}
