diff --git a/packages/shared/pkg/featureflags/local_capacity.go b/packages/shared/pkg/featureflags/local_capacity.go
new file mode 100644
index 0000000..fc510fd
--- /dev/null
+++ b/packages/shared/pkg/featureflags/local_capacity.go
@@ -0,0 +1,23 @@
+package featureflags
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+)
+
+// maxSandboxesPerNodeFallback provides a local setting for deployments that
+// do not use LaunchDarkly. A configured remote flag still takes precedence.
+func maxSandboxesPerNodeFallback() int {
+	raw, set := os.LookupEnv("E2B_MAX_SANDBOXES_PER_NODE")
+	if !set {
+		return 200
+	}
+
+	limit, err := strconv.Atoi(raw)
+	if err != nil || limit <= 0 {
+		panic(fmt.Sprintf("E2B_MAX_SANDBOXES_PER_NODE must be a positive integer, got %q", raw))
+	}
+
+	return limit
+}
diff --git a/packages/shared/pkg/featureflags/local_capacity_test.go b/packages/shared/pkg/featureflags/local_capacity_test.go
new file mode 100644
index 0000000..067c217
--- /dev/null
+++ b/packages/shared/pkg/featureflags/local_capacity_test.go
@@ -0,0 +1,28 @@
+package featureflags
+
+import (
+	"os"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestLocalSandboxCapacityDefault(t *testing.T) {
+	t.Setenv("E2B_MAX_SANDBOXES_PER_NODE", "temporary")
+	require.NoError(t, os.Unsetenv("E2B_MAX_SANDBOXES_PER_NODE"))
+	require.Equal(t, 200, maxSandboxesPerNodeFallback())
+}
+
+func TestLocalSandboxCapacityOverride(t *testing.T) {
+	t.Setenv("E2B_MAX_SANDBOXES_PER_NODE", "512")
+	require.Equal(t, 512, maxSandboxesPerNodeFallback())
+}
+
+func TestLocalSandboxCapacityRejectsInvalid(t *testing.T) {
+	for _, value := range []string{"", "0", "-1", "invalid", "512.5", "9999999999999999999999999"} {
+		t.Run(value, func(t *testing.T) {
+			t.Setenv("E2B_MAX_SANDBOXES_PER_NODE", value)
+			require.Panics(t, func() { maxSandboxesPerNodeFallback() })
+		})
+	}
+}
