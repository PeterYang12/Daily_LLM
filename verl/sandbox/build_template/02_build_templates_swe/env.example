# Copy to `env` (git-ignored), chmod 600, and fill in.

# E2B server. API and sandbox traffic use the same address on our self-hosted server.
E2B_API_URL=http://<e2b-server-address>
E2B_SANDBOX_URL=http://<e2b-server-address>
E2B_API_KEY=<e2b api key>

# Docker Hub account, optional. Sent to the E2B server with every build request so it pulls images with this
# account instead of anonymously (anonymous is limited to 100 pulls per hour). Use an access token, not a password.
DOCKERHUB_USERNAME=<docker hub user>
DOCKERHUB_TOKEN=<docker hub access token>
