FROM python:3.12@sha256:cd7c412d000912f29075a1b8803e43cb2f38bb67f104019df526df5ceaf30569
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources && apt-get update -qq && apt-get install -y -qq tmux && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir numpy==2.4.3
