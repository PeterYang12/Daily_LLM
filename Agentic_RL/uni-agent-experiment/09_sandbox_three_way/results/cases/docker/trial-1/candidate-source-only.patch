+#!/usr/bin/env python3
+"""
+Additional edge case tests for blueprint name validation.
+"""
+
+import flask
+
+def test_edge_cases():
+    """Test various edge cases for blueprint names."""
+    print("Testing edge cases for blueprint names...")
+    
+    # Test cases: (name, should_raise_error, description)
+    test_cases = [
+        ("", True, "Empty string"),
+        ("   ", False, "String with whitespace"),
+        ("\t\n", False, "String with tabs and newlines"),
+        ("valid_name", False, "Valid name"),
+        ("name.with.dots", True, "Name with dots"),
+        ("name_with_underscores", False, "Name with underscores"),
+        ("Name123", False, "Name with numbers"),
+        ("_private_name", False, "Name starting with underscore"),
+        ("name-", False, "Name with hyphen"),
+    ]
+    
+    results = []
+    
+    for name, should_raise_error, description in test_cases:
+        print(f"  Testing {description}: '{name}'")
+        try:
+            bp = flask.Blueprint(name, __name__)
+            if should_raise_error:
+                print(f"    ERROR: Should have raised ValueError but didn't")
+                results.append(False)
+            else:
+                print(f"    SUCCESS: Blueprint created successfully")
+                results.append(True)
+        except ValueError as e:
+            if should_raise_error:
+                print(f"    SUCCESS: ValueError raised as expected: {e}")
+                results.append(True)
+            else:
+                print(f"    ERROR: Unexpected ValueError: {e}")
+                results.append(False)
+        except Exception as e:
+            print(f"    ERROR: Unexpected exception: {e}")
+            results.append(False)
+    
+    return results
+
+def test_register_edge_cases():
+    """Test registering blueprints with various names."""
+    print("\nTesting edge cases for blueprint registration...")
+    
+    app = flask.Flask(__name__)
+    
+    # Test valid registration
+    try:
+        bp = flask.Blueprint("valid_bp", __name__)
+        app.register_blueprint(bp)
+        print("  SUCCESS: Valid blueprint registered")
+        valid_result = True
+    except Exception as e:
+        print(f"  ERROR: Valid blueprint failed to register: {e}")
+        valid_result = False
+    
+    # Test invalid registration (empty name)
+    try:
+        bp = flask.Blueprint("", __name__)
+        app.register_blueprint(bp)
+        print("  ERROR: Empty name blueprint was registered")
+        empty_result = False
+    except ValueError as e:
+        print(f"  SUCCESS: Empty name blueprint correctly rejected: {e}")
+        empty_result = True
+    except Exception as e:
+        print(f"  ERROR: Unexpected exception for empty name: {e}")
+        empty_result = False
+    
+    return [valid_result, empty_result]
+
+def test_nested_blueprints():
+    """Test nested blueprints with empty names."""
+    print("\nTesting nested blueprints...")
+    
+    # Test that nested blueprints also validate names
+    try:
+        parent = flask.Blueprint("parent", __name__)
+        child = flask.Blueprint("", __name__)  # Empty name
+        
+        parent.register_blueprint(child)
+        print("  ERROR: Child blueprint with empty name was registered")
+        return False
+    except ValueError as e:
+        print(f"  SUCCESS: Child blueprint with empty name correctly rejected: {e}")
+        return True
+    except Exception as e:
+        print(f"  ERROR: Unexpected exception: {e}")
+        return False
+
+if __name__ == "__main__":
+    print("Running edge case tests for blueprint name validation...\n")
+    
+    edge_results = test_edge_cases()
+    register_results = test_register_edge_cases()
+    nested_result = test_nested_blueprints()
+    
+    all_results = edge_results + register_results + [nested_result]
+    
+    print(f"\nResults: {sum(all_results)}/{len(all_results)} tests passed")
+    
+    if all(all_results):
+        print("All edge case tests passed!")
+    else:
+        print("Some edge case tests failed!")
