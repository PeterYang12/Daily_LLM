+#!/usr/bin/env python3
+"""
+Script to reproduce the issue with empty blueprint names.
+"""
+
+import flask
+
+def test_empty_blueprint_name():
+    """Test creating a blueprint with an empty name."""
+    print("Testing blueprint with empty name...")
+    try:
+        # This should raise a ValueError according to the issue
+        bp = flask.Blueprint("", __name__)
+        print("ERROR: Blueprint with empty name was created successfully!")
+        print("This should have raised a ValueError.")
+        return False
+    except ValueError as e:
+        print(f"SUCCESS: ValueError raised as expected: {e}")
+        return True
+    except Exception as e:
+        print(f"ERROR: Unexpected exception: {e}")
+        return False
+
+def test_none_blueprint_name():
+    """Test creating a blueprint with None name."""
+    print("\nTesting blueprint with None name...")
+    try:
+        # This should also raise a ValueError
+        bp = flask.Blueprint(None, __name__)
+        print("ERROR: Blueprint with None name was created successfully!")
+        print("This should have raised a ValueError.")
+        return False
+    except TypeError as e:
+        # This is expected since None is not a valid string
+        print(f"SUCCESS: TypeError raised as expected (None not valid for str type): {e}")
+        return True
+    except ValueError as e:
+        print(f"SUCCESS: ValueError raised as expected: {e}")
+        return True
+    except Exception as e:
+        print(f"ERROR: Unexpected exception: {e}")
+        return False
+
+def test_valid_blueprint_name():
+    """Test creating a blueprint with a valid name."""
+    print("\nTesting blueprint with valid name...")
+    try:
+        bp = flask.Blueprint("valid_name", __name__)
+        print("SUCCESS: Blueprint with valid name was created successfully!")
+        return True
+    except Exception as e:
+        print(f"ERROR: Unexpected exception: {e}")
+        return False
+
+def test_register_empty_blueprint():
+    """Test registering a blueprint with an empty name."""
+    print("\nTesting registering blueprint with empty name...")
+    app = flask.Flask(__name__)
+    try:
+        bp = flask.Blueprint("", __name__)
+        app.register_blueprint(bp)
+        print("ERROR: Blueprint with empty name was registered successfully!")
+        print("This should have raised a ValueError.")
+        return False
+    except ValueError as e:
+        print(f"SUCCESS: ValueError raised as expected: {e}")
+        return True
+    except Exception as e:
+        print(f"ERROR: Unexpected exception: {e}")
+        return False
+
+if __name__ == "__main__":
+    print("Reproducing the issue with empty blueprint names...")
+    
+    results = []
+    results.append(test_empty_blueprint_name())
+    results.append(test_none_blueprint_name())
+    results.append(test_valid_blueprint_name())
+    results.append(test_register_empty_blueprint())
+    
+    print(f"\nResults: {sum(results)}/{len(results)} tests passed")
+    
+    if all(results):
+        print("All tests passed - issue is fixed!")
+    else:
+        print("Some tests failed - issue still exists!")
