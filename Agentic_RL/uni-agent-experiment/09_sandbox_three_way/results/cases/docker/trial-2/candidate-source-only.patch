+#!/usr/bin/env python3
+"""
+Additional edge case tests for the blueprint name validation fix.
+"""
+
+import sys
+import os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'src'))
+
+import flask
+
+def test_edge_cases():
+    """Test various edge cases for blueprint names."""
+    
+    # Test cases that should work
+    valid_names = [
+        "simple",
+        "with_underscore",
+        "with-dash",
+        "with123number",
+        "a",  # single character
+        "name_with_underscores_and_numbers_123",
+    ]
+    
+    print("Testing valid blueprint names...")
+    for name in valid_names:
+        try:
+            bp = flask.Blueprint(name, __name__)
+            print(f"  SUCCESS: '{name}' - {bp.name}")
+        except Exception as e:
+            print(f"  ERROR: '{name}' - {e}")
+    
+    # Test cases that should fail
+    invalid_names = [
+        "",           # empty string
+        "   ",        # whitespace only
+        "\t\n",       # whitespace characters
+        " \t \n ",    # mixed whitespace
+    ]
+    
+    print("\nTesting invalid blueprint names...")
+    for name in invalid_names:
+        try:
+            bp = flask.Blueprint(name, __name__)
+            print(f"  ERROR: '{repr(name)}' - Should have failed but didn't")
+        except ValueError as e:
+            print(f"  SUCCESS: '{repr(name)}' - Correctly rejected: {e}")
+        except Exception as e:
+            print(f"  UNEXPECTED: '{repr(name)}' - Wrong exception type: {e}")
+
+    # Test that existing validations still work
+    print("\nTesting existing validations still work...")
+    try:
+        bp = flask.Blueprint("name.with.dot", __name__)
+        print("  ERROR: Dot in name should have been rejected")
+    except ValueError as e:
+        print(f"  SUCCESS: Dot validation still works: {e}")
+    
+    print("\nAll edge case tests completed.")
+
+if __name__ == "__main__":
+    test_edge_cases()
