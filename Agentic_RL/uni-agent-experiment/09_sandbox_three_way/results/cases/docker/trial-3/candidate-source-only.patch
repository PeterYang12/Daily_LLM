+    result2 = test_normal_usage_still_works()
+    
+    print("\n" + "=" * 50)
+    if result1 and result2:
+        print("✓ ALL TESTS PASSED - Issue is resolved!")
+    else:
+        print("✗ SOME TESTS FAILED")
+        exit(1)
