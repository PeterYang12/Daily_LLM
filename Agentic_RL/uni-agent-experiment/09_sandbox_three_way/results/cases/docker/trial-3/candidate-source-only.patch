+#!/usr/bin/env python3
+"""
+Additional edge case tests for Blueprint name validation.
+"""
+
+import flask
+
+def test_edge_cases():
+    """Test various edge cases for Blueprint names."""
+    
+    # Test cases that should work
+    valid_names = [
+        "simple",
+        "with_underscore",
+        "with-dash",
+        "with123number",
+        "Mixed_Case123",
+        "a",  # single character
+        "name_with_underscores_and_numbers_123",
+    ]
+    
+    print("Testing valid blueprint names...")
+    for name in valid_names:
+        try:
+            bp = flask.Blueprint(name, __name__)
+            print(f"  ✓ '{name}' - OK")
+        except Exception as e:
+            print(f"  ✗ '{name}' - ERROR: {e}")
+            return False
+    
+    # Test cases that should fail
+    invalid_names = [
+        "",           # empty string
+        "   ",        # whitespace only
+        "\t\n",       # whitespace characters
+        " \t \n ",    # mixed whitespace
+    ]
+    
+    print("\nTesting invalid blueprint names...")
+    for name in invalid_names:
+        try:
+            bp = flask.Blueprint(name, __name__)
+            print(f"  ✗ '{repr(name)}' - Should have failed but didn't!")
+            return False
+        except ValueError as e:
+            print(f"  ✓ '{repr(name)}' - Correctly rejected: {e}")
+        except Exception as e:
+            print(f"  ? '{repr(name)}' - Unexpected error: {e}")
+            return False
+    
+    # Test that existing functionality still works
+    print("\nTesting existing functionality...")
+    
+    # Test blueprint registration
+    app = flask.Flask(__name__)
+    bp = flask.Blueprint("test_bp", __name__)
+    
+    @bp.route('/')
+    def hello():
+        return "Hello World"
+    
+    app.register_blueprint(bp)
+    
+    with app.test_client() as client:
+        response = client.get('/')
+        if response.data == b'Hello World':
+            print("  ✓ Blueprint registration and routing works")
+        else:
+            print(f"  ✗ Blueprint routing failed: {response.data}")
+            return False
+    
+    # Test nested blueprints
+    parent_bp = flask.Blueprint("parent", __name__)
+    child_bp = flask.Blueprint("child", __name__)
+    
+    parent_bp.register_blueprint(child_bp)
+    print("  ✓ Nested blueprint registration works")
+    
+    return True
+
+if __name__ == "__main__":
+    print("Running edge case tests for Blueprint name validation...")
+    success = test_edge_cases()
+    if success:
+        print("\n✓ All edge case tests passed!")
+    else:
+        print("\n✗ Some edge case tests failed!")
+        exit(1)
