+#!/usr/bin/env python3
+"""
+Additional edge case tests for the empty blueprint name fix.
+"""
+
+import sys
+import os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'src'))
+
+import flask
+
+def test_various_empty_names():
+    """Test various forms of empty names."""
+    print("Testing various empty name forms...")
+    
+    empty_names = ["", " ", "\t", "\n"]
+    all_passed = True
+    
+    for empty_name in empty_names:
+        try:
+            bp = flask.Blueprint(empty_name, __name__)
+            print(f"ERROR: No exception for name '{repr(empty_name)}'")
+            all_passed = False
+        except ValueError as e:
+            if "'name' must not be empty." in str(e):
+                print(f"SUCCESS: Correctly rejected name '{repr(empty_name)}'")
+            else:
+                print(f"ERROR: Wrong exception for name '{repr(empty_name)}': {e}")
+                all_passed = False
+        except Exception as e:
+            print(f"ERROR: Unexpected exception for name '{repr(empty_name)}': {e}")
+            all_passed = False
+    
+    return all_passed
+
+def test_valid_names():
+    """Test that valid names still work."""
+    print("\nTesting valid names...")
+    
+    valid_names = ["test", "my_blueprint", "Blueprint123", "a"]
+    all_passed = True
+    
+    for valid_name in valid_names:
+        try:
+            bp = flask.Blueprint(valid_name, __name__)
+            print(f"SUCCESS: Valid name '{valid_name}' accepted")
+        except Exception as e:
+            print(f"ERROR: Valid name '{valid_name}' rejected: {e}")
+            all_passed = False
+    
+    return all_passed
+
+def test_dot_validation_still_works():
+    """Test that dot validation still works after our change."""
+    print("\nTesting that dot validation still works...")
+    
+    try:
+        bp = flask.Blueprint("invalid.name", __name__)
+        print("ERROR: No exception for dot in name")
+        return False
+    except ValueError as e:
+        if "'name' may not contain a dot '.' character." in str(e):
+            print("SUCCESS: Dot validation still works")
+            return True
+        else:
+            print(f"ERROR: Wrong exception for dot validation: {e}")
+            return False
+    except Exception as e:
+        print(f"ERROR: Unexpected exception for dot validation: {e}")
+        return False
+
+def test_blueprint_registration_with_empty_name():
+    """Test that registration of blueprint with empty name fails."""
+    print("\nTesting blueprint registration with empty name...")
+    
+    app = flask.Flask(__name__)
+    
+    try:
+        bp = flask.Blueprint("", __name__)
+        app.register_blueprint(bp)
+        print("ERROR: No exception during registration of empty name blueprint")
+        return False
+    except ValueError as e:
+        if "'name' must not be empty." in str(e):
+            print("SUCCESS: Correctly rejected empty name during registration")
+            return True
+        else:
+            print(f"ERROR: Wrong exception during registration: {e}")
+            return False
+    except Exception as e:
+        print(f"ERROR: Unexpected exception during registration: {e}")
+        return False
+
+def test_blueprint_with_whitespace_only_name():
+    """Test blueprint with whitespace-only name."""
+    print("\nTesting blueprint with whitespace-only name...")
+    
+    try:
+        bp = flask.Blueprint("   ", __name__)
+        print("SUCCESS: Whitespace-only name accepted (this might be intended)")
+        return True
+    except ValueError as e:
+        if "'name' must not be empty." in str(e):
+            print("SUCCESS: Whitespace-only name correctly rejected")
+            return True
+        else:
+            print(f"ERROR: Unexpected exception for whitespace name: {e}")
+            return False
+    except Exception as e:
+        print(f"ERROR: Unexpected exception for whitespace name: {e}")
+        return False
+
+if __name__ == "__main__":
+    print("Running edge case tests for empty blueprint name validation...")
+    
+    results = [
+        test_various_empty_names(),
+        test_valid_names(),
+        test_dot_validation_still_works(),
+        test_blueprint_registration_with_empty_name(),
+        test_blueprint_with_whitespace_only_name()
+    ]
+    
+    if all(results):
+        print("\nAll edge case tests passed!")
+        sys.exit(0)
+    else:
+        print("\nSome edge case tests failed!")
+        sys.exit(1)
