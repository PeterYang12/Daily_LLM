+#!/usr/bin/env python3
+"""
+Final verification that the issue described in the GitHub issue is fixed.
+"""
+
+import sys
+import os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'src'))
+
+import flask
+
+def test_issue_fixed():
+    """Test that the exact issue described is now fixed."""
+    print("Testing that the issue is fixed...")
+    
+    # The issue states: "Things do not work correctly if a Blueprint is given an empty name"
+    # and "It would be helpful if a ValueError was raised when trying to do that."
+    
+    try:
+        # This should raise a ValueError now
+        bp = flask.Blueprint("", __name__)
+        print("FAIL: No ValueError raised for empty blueprint name")
+        return False
+    except ValueError as e:
+        if "'name' must not be empty." in str(e):
+            print("SUCCESS: ValueError correctly raised for empty blueprint name")
+        else:
+            print(f"FAIL: Wrong ValueError message: {e}")
+            return False
+    except Exception as e:
+        print(f"FAIL: Unexpected exception type: {e}")
+        return False
+    
+    # Also test that it works with normal names
+    try:
+        bp = flask.Blueprint("my_blueprint", __name__)
+        print("SUCCESS: Normal blueprint names still work")
+    except Exception as e:
+        print(f"FAIL: Normal blueprint names broken: {e}")
+        return False
+    
+    # Test that it works with registration too
+    app = flask.Flask(__name__)
+    try:
+        bp = flask.Blueprint("", __name__)
+        app.register_blueprint(bp)
+        print("FAIL: No ValueError raised during registration with empty name")
+        return False
+    except ValueError as e:
+        if "'name' must not be empty." in str(e):
+            print("SUCCESS: ValueError correctly raised during registration with empty name")
+        else:
+            print(f"FAIL: Wrong ValueError message during registration: {e}")
+            return False
+    except Exception as e:
+        print(f"FAIL: Unexpected exception type during registration: {e}")
+        return False
+    
+    return True
+
+if __name__ == "__main__":
+    print("Final verification of the fix for empty blueprint name issue...")
+    
+    if test_issue_fixed():
+        print("\n✅ Issue is successfully fixed!")
+        sys.exit(0)
+    else:
+        print("\n❌ Issue is NOT fixed!")
+        sys.exit(1)
