+#!/usr/bin/env python3
+"""
+Script to reproduce the issue with empty blueprint names.
+"""
+
+import sys
+import os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'src'))
+
+import flask
+
+def test_empty_blueprint_name():
+    """Test creating a blueprint with an empty name."""
+    print("Testing blueprint creation with empty name...")
+    
+    try:
+        # This should raise a ValueError according to the issue
+        bp = flask.Blueprint("", __name__)
+        print("ERROR: No exception raised for empty blueprint name!")
+        return False
+    except ValueError as e:
+        print(f"SUCCESS: ValueError raised as expected: {e}")
+        return True
+    except Exception as e:
+        print(f"UNEXPECTED: Different exception raised: {e}")
+        return False
+
+def test_empty_blueprint_registration():
+    """Test registering a blueprint with an empty name."""
+    print("\nTesting blueprint registration with empty name...")
+    
+    app = flask.Flask(__name__)
+    
+    try:
+        # Create a blueprint with empty name
+        bp = flask.Blueprint("", __name__)
+        
+        # Try to register it
+        app.register_blueprint(bp)
+        print("ERROR: No exception raised for empty blueprint name during registration!")
+        return False
+    except ValueError as e:
+        print(f"SUCCESS: ValueError raised as expected: {e}")
+        return True
+    except Exception as e:
+        print(f"UNEXPECTED: Different exception raised: {e}")
+        return False
+
+def test_normal_blueprint():
+    """Test that normal blueprints still work."""
+    print("\nTesting normal blueprint creation and registration...")
+    
+    try:
+        app = flask.Flask(__name__)
+        bp = flask.Blueprint("test_bp", __name__)
+        app.register_blueprint(bp)
+        print("SUCCESS: Normal blueprint works correctly")
+        return True
+    except Exception as e:
+        print(f"ERROR: Normal blueprint failed: {e}")
+        return False
+
+if __name__ == "__main__":
+    print("Reproducing the empty blueprint name issue...")
+    
+    result1 = test_empty_blueprint_name()
+    result2 = test_empty_blueprint_registration()
+    result3 = test_normal_blueprint()
+    
+    if result1 and result2:
+        print("\nAll tests passed - issue is already fixed!")
+        sys.exit(0)
+    elif result3:
+        print("\nIssue reproduced - empty names are not properly validated!")
+        sys.exit(1)
+    else:
+        print("\nUnexpected behavior!")
+        sys.exit(2)
