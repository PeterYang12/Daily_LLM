+#!/usr/bin/env python3
+"""
+Additional edge case tests for blueprint name validation.
+"""
+
+from flask import Flask, Blueprint
+
+def test_edge_cases():
+    """Test various edge cases for blueprint names."""
+    print("Testing edge cases for blueprint names...")
+    
+    # Test valid names
+    valid_names = [
+        "valid_bp",
+        "bp_with_underscores",
+        "bp-with-dashes",
+        "bp123",
+        "BP",
+        "a",  # single character
+    ]
+    
+    for name in valid_names:
+        try:
+            bp = Blueprint(name, 'test_bp')
+            print(f"SUCCESS: Blueprint with name '{name}' created successfully")
+        except Exception as e:
+            print(f"ERROR: Failed to create blueprint with name '{name}': {e}")
+            return False
+    
+    # Test invalid names (empty string, None, whitespace)
+    invalid_names = [
+        "",      # empty string
+        "   ",   # whitespace only
+        None,    # None value
+    ]
+    
+    for name in invalid_names:
+        try:
+            bp = Blueprint(name, 'test_bp')
+            print(f"ERROR: Blueprint with invalid name '{name}' was created successfully!")
+            return False
+        except ValueError as e:
+            print(f"SUCCESS: ValueError raised for invalid name '{name}': {e}")
+        except Exception as e:
+            print(f"ERROR: Unexpected exception for invalid name '{name}': {e}")
+            return False
+    
+    # Test that existing validations still work (dots)
+    try:
+        bp = Blueprint("invalid.name", 'test_bp')
+        print("ERROR: Blueprint with dot in name was created successfully!")
+        return False
+    except ValueError as e:
+        print(f"SUCCESS: ValueError raised for dot in name: {e}")
+    except Exception as e:
+        print(f"ERROR: Unexpected exception for dot in name: {e}")
+        return False
+    
+    # Test that blueprints can still be registered
+    try:
+        app = Flask(__name__)
+        bp = Blueprint("test_bp", 'test_bp')
+        app.register_blueprint(bp)
+        print("SUCCESS: Blueprint registration works correctly")
+    except Exception as e:
+        print(f"ERROR: Blueprint registration failed: {e}")
+        return False
+    
+    return True
+
+if __name__ == "__main__":
+    print("Running edge case tests for blueprint name validation...")
+    print("=" * 60)
+    
+    if test_edge_cases():
+        print("=" * 60)
+        print("All edge case tests passed!")
+    else:
+        print("=" * 60)
+        print("Some edge case tests failed!")
