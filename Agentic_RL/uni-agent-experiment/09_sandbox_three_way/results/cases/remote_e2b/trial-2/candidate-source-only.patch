+#!/usr/bin/env python3
+"""
+Additional edge case tests for the blueprint name validation.
+"""
+
+from flask import Flask, Blueprint
+
+def test_edge_cases():
+    """Test various edge cases for blueprint names."""
+    print("Testing edge cases for blueprint names...")
+    
+    # Test cases: (name, should_raise_error, description)
+    test_cases = [
+        ("", True, "Empty string"),
+        ("   ", True, "Whitespace only"),
+        ("\t\n", True, "Tab and newline only"),
+        (" \t \n ", True, "Mixed whitespace"),
+        ("normal_name", False, "Normal name"),
+        ("name_with_underscores", False, "Name with underscores"),
+        ("name-with-dashes", False, "Name with dashes"),
+        ("Name123", False, "Name with numbers"),
+        ("_leading_underscore", False, "Name with leading underscore"),
+        ("trailing_underscore_", False, "Name with trailing underscore"),
+        ("a", False, "Single character"),
+        ("1", False, "Single digit"),
+        ("name.with.dots", True, "Name with dots (should fail)"),
+    ]
+    
+    all_passed = True
+    
+    for name, should_raise, description in test_cases:
+        try:
+            bp = Blueprint(name, 'test_bp')
+            if should_raise:
+                print(f"FAIL: {description} - Expected ValueError but got success")
+                all_passed = False
+            else:
+                print(f"PASS: {description} - Created successfully with name '{bp.name}'")
+        except ValueError as e:
+            if should_raise:
+                print(f"PASS: {description} - Correctly raised ValueError: {e}")
+            else:
+                print(f"FAIL: {description} - Unexpected ValueError: {e}")
+                all_passed = False
+        except Exception as e:
+            print(f"FAIL: {description} - Unexpected exception: {e}")
+            all_passed = False
+    
+    return all_passed
+
+def test_blueprint_registration():
+    """Test that blueprints with valid names can still be registered."""
+    print("\nTesting blueprint registration with valid names...")
+    
+    try:
+        app = Flask(__name__)
+        bp1 = Blueprint('valid_bp', 'test_bp')
+        bp2 = Blueprint('another_bp', 'test_bp')
+        
+        # These should work without issues
+        app.register_blueprint(bp1)
+        app.register_blueprint(bp2)
+        
+        print("PASS: Blueprints with valid names registered successfully")
+        return True
+    except Exception as e:
+        print(f"FAIL: Error during blueprint registration: {e}")
+        return False
+
+if __name__ == "__main__":
+    print("Running edge case tests...")
+    
+    result1 = test_edge_cases()
+    result2 = test_blueprint_registration()
+    
+    if result1 and result2:
+        print("\nAll edge case tests passed!")
+    else:
+        print("\nSome edge case tests failed!")
