+#!/usr/bin/env python3
+"""Edge case tests for blueprint name validation."""
+
+import flask
+
+def test_whitespace_blueprint_name():
+    """Test that blueprint names with only whitespace are rejected."""
+    try:
+        bp = flask.Blueprint('   ', __name__)
+        print(f"Blueprint with whitespace name works: '{bp.name}'")
+        # This should actually work since whitespace is not empty
+        return True
+    except Exception as e:
+        print(f"ERROR with whitespace name: {e}")
+        return False
+
+def test_empty_string_variants():
+    """Test various empty-like strings."""
+    empty_variants = ['', ' ', '\t', '\n']
+    
+    for i, empty_str in enumerate(empty_variants):
+        try:
+            bp = flask.Blueprint(empty_str, __name__)
+            if empty_str == '':
+                print(f"ERROR: Empty string '{empty_str}' was accepted")
+                return False
+            else:
+                print(f"SUCCESS: Non-empty string '{empty_str}' accepted")
+        except ValueError as e:
+            if "'name' must not be empty." in str(e) and empty_str == '':
+                print(f"SUCCESS: Empty string properly rejected: {e}")
+            elif empty_str != '':
+                print(f"SUCCESS: Non-empty string '{empty_str}' properly handled")
+            else:
+                print(f"ERROR: Unexpected rejection of '{empty_str}': {e}")
+                return False
+        except Exception as e:
+            print(f"ERROR: Unexpected exception for '{empty_str}': {e}")
+            return False
+    
+    return True
+
+def test_blueprint_with_special_characters():
+    """Test that blueprint names with special characters work (except dots)."""
+    try:
+        # These should work
+        bp1 = flask.Blueprint('test-blueprint', __name__)
+        bp2 = flask.Blueprint('test_blueprint', __name__)
+        bp3 = flask.Blueprint('test123', __name__)
+        bp4 = flask.Blueprint('test_123', __name__)
+        print("SUCCESS: Blueprint names with special characters work")
+        return True
+    except Exception as e:
+        print(f"ERROR: Blueprint names with special characters failed: {e}")
+        return False
+
+def test_blueprint_nested_registration():
+    """Test nested blueprint registration with empty names."""
+    app = flask.Flask(__name__)
+    
+    # Test parent blueprint with empty name
+    try:
+        parent_bp = flask.Blueprint('', __name__)
+        child_bp = flask.Blueprint('child', __name__)
+        parent_bp.register_blueprint(child_bp)
+        print("ERROR: Parent blueprint with empty name was registered")
+        return False
+    except ValueError as e:
+        if "'name' must not be empty." in str(e):
+            print(f"SUCCESS: Parent blueprint with empty name properly rejected: {e}")
+        else:
+            print(f"ERROR: Wrong error for parent blueprint: {e}")
+            return False
+    
+    # Test child blueprint with empty name
+    try:
+        parent_bp = flask.Blueprint('parent', __name__)
+        child_bp = flask.Blueprint('', __name__)
+        parent_bp.register_blueprint(child_bp)
+        print("ERROR: Child blueprint with empty name was registered")
+        return False
+    except ValueError as e:
+        if "'name' must not be empty." in str(e):
+            print(f"SUCCESS: Child blueprint with empty name properly rejected: {e}")
+        else:
+            print(f"ERROR: Wrong error for child blueprint: {e}")
+            return False
+    
+    return True
+
+def test_blueprint_name_with_dots_still_rejected():
+    """Ensure that names with dots are still properly rejected."""
+    try:
+        bp = flask.Blueprint('test.name', __name__)
+        print("ERROR: Blueprint name with dot was accepted")
+        return False
+    except ValueError as e:
+        if "'name' may not contain a dot '.' character." in str(e):
+            print(f"SUCCESS: Blueprint name with dot properly rejected: {e}")
+            return True
+        else:
+            print(f"ERROR: Wrong error for dot name: {e}")
+            return False
+    except Exception as e:
+        print(f"ERROR: Unexpected exception: {e}")
+        return False
+
+if __name__ == "__main__":
+    print("Running edge case tests...")
+    
+    results = []
+    results.append(test_whitespace_blueprint_name())
+    results.append(test_empty_string_variants())
+    results.append(test_blueprint_with_special_characters())
+    results.append(test_blueprint_nested_registration())
+    results.append(test_blueprint_name_with_dots_still_rejected())
+    
+    if all(results):
+        print("\nAll edge case tests passed!")
+    else:
+        print("\nSome edge case tests failed!")
