+#!/usr/bin/env python3
+"""
+Additional edge case tests for blueprint name validation.
+"""
+
+import flask
+
+def test_edge_cases():
+    """Test various edge cases for blueprint names."""
+    
+    # Test with whitespace-only name
+    try:
+        bp = flask.Blueprint('   ', __name__)
+        print("INFO: Blueprint with whitespace name created (may be acceptable)")
+    except ValueError as e:
+        print(f"Blueprint with whitespace name rejected: {e}")
+    
+    # Test with None (should fail)
+    try:
+        bp = flask.Blueprint(None, __name__)
+        print("ERROR: Blueprint with None name should have failed")
+    except Exception as e:
+        print(f"Blueprint with None name correctly rejected: {type(e).__name__}: {e}")
+    
+    # Test with empty string (should fail)
+    try:
+        bp = flask.Blueprint('', __name__)
+        print("ERROR: Blueprint with empty name should have failed")
+    except ValueError as e:
+        print(f"Blueprint with empty name correctly rejected: {e}")
+    
+    # Test with valid names
+    valid_names = ['test', 'test123', 'test_name', 'test-name', 'Test.Name']
+    
+    for name in valid_names:
+        try:
+            bp = flask.Blueprint(name, __name__)
+            print(f"Valid name '{name}' accepted correctly")
+        except Exception as e:
+            print(f"ERROR: Valid name '{name}' rejected: {e}")
+    
+    # Test registration with valid name
+    app = flask.Flask(__name__)
+    try:
+        bp = flask.Blueprint('valid_bp', __name__)
+        app.register_blueprint(bp)
+        print("Blueprint with valid name registered successfully")
+    except Exception as e:
+        print(f"ERROR: Valid blueprint registration failed: {e}")
+    
+    # Test registration with empty name (should fail)
+    try:
+        bp = flask.Blueprint('', __name__)
+        app.register_blueprint(bp)
+        print("ERROR: Blueprint with empty name should not be registrable")
+    except ValueError as e:
+        print(f"Blueprint with empty name correctly rejected at registration: {e}")
+
+if __name__ == "__main__":
+    print("Running edge case tests for blueprint name validation...")
+    test_edge_cases()
+    print("Edge case tests completed.")
