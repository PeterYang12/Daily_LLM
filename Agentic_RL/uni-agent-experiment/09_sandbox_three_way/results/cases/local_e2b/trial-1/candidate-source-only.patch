+#!/usr/bin/env python3
+"""
+Additional edge case tests for Blueprint name validation.
+"""
+
+import flask
+
+def test_edge_cases():
+    """Test various edge cases for blueprint names."""
+    print("Testing edge cases for Blueprint names...")
+    
+    # Test empty string
+    try:
+        bp = flask.Blueprint("", __name__)
+        print("FAIL: Empty string name should raise ValueError")
+        return False
+    except ValueError as e:
+        print(f"PASS: Empty string correctly raises ValueError: {e}")
+    
+    # Test None
+    try:
+        bp = flask.Blueprint(None, __name__)
+        print("FAIL: None name should raise ValueError")
+        return False
+    except ValueError as e:
+        print(f"PASS: None correctly raises ValueError: {e}")
+    
+    # Test whitespace-only string
+    try:
+        bp = flask.Blueprint("   ", __name__)
+        print("PASS: Whitespace-only string is allowed (not empty)")
+    except ValueError as e:
+        print(f"INFO: Whitespace-only string raises ValueError: {e}")
+    
+    # Test dot in name (should still fail)
+    try:
+        bp = flask.Blueprint("test.name", __name__)
+        print("FAIL: Dot in name should raise ValueError")
+        return False
+    except ValueError as e:
+        print(f"PASS: Dot in name correctly raises ValueError: {e}")
+    
+    # Test valid names
+    valid_names = ["test", "test123", "test_name", "test-name"]
+    for name in valid_names:
+        try:
+            bp = flask.Blueprint(name, __name__)
+            print(f"PASS: Valid name '{name}' works")
+        except Exception as e:
+            print(f"FAIL: Valid name '{name}' should work but raised: {e}")
+            return False
+    
+    # Test registration with valid name
+    try:
+        bp = flask.Blueprint("valid_bp", __name__)
+        app = flask.Flask(__name__)
+        app.register_blueprint(bp)
+        print("PASS: Valid blueprint registration works")
+    except Exception as e:
+        print(f"FAIL: Valid blueprint registration failed: {e}")
+        return False
+    
+    # Test registration with empty name (should fail)
+    try:
+        bp = flask.Blueprint("", __name__)
+        app = flask.Flask(__name__)
+        app.register_blueprint(bp)
+        print("FAIL: Empty name blueprint registration should fail")
+        return False
+    except ValueError as e:
+        print(f"PASS: Empty name blueprint registration correctly fails: {e}")
+    
+    return True
+
+if __name__ == "__main__":
+    success = test_edge_cases()
+    if success:
+        print("\nAll edge case tests passed!")
+    else:
+        print("\nSome edge case tests failed!")
