+#!/usr/bin/env python3
+"""
+Script to reproduce the issue with empty Blueprint names.
+"""
+
+import flask
+
+def test_empty_blueprint_name():
+    """Test creating a Blueprint with an empty name."""
+    print("Testing Blueprint creation with empty name...")
+    
+    try:
+        # This should raise a ValueError according to the issue
+        bp = flask.Blueprint("", __name__)
+        print("ERROR: Blueprint with empty name was created successfully!")
+        print(f"Blueprint name: '{bp.name}'")
+        
+        # Try to register it to see what happens
+        app = flask.Flask(__name__)
+        try:
+            app.register_blueprint(bp)
+            print("ERROR: Blueprint with empty name was registered successfully!")
+        except Exception as e:
+            print(f"Registration error: {type(e).__name__}: {e}")
+        return False
+    except ValueError as e:
+        print(f"SUCCESS: ValueError raised as expected: {e}")
+        return True
+    except Exception as e:
+        print(f"UNEXPECTED ERROR: {type(e).__name__}: {e}")
+        return False
+
+def test_none_blueprint_name():
+    """Test creating a Blueprint with None name."""
+    print("\nTesting Blueprint creation with None name...")
+    
+    try:
+        # This should also raise a ValueError
+        bp = flask.Blueprint(None, __name__)
+        print("ERROR: Blueprint with None name was created successfully!")
+        print(f"Blueprint name: {bp.name}")
+        return False
+    except ValueError as e:
+        print(f"SUCCESS: ValueError raised as expected: {e}")
+        return True
+    except Exception as e:
+        print(f"UNEXPECTED ERROR: {type(e).__name__}: {e}")
+        return False
+
+def test_valid_blueprint_name():
+    """Test creating a Blueprint with a valid name."""
+    print("\nTesting Blueprint creation with valid name...")
+    
+    try:
+        bp = flask.Blueprint("valid_name", __name__)
+        print(f"SUCCESS: Blueprint with valid name created: '{bp.name}'")
+        return True
+    except Exception as e:
+        print(f"ERROR: Failed to create Blueprint with valid name: {type(e).__name__}: {e}")
+        return False
+
+def test_empty_name_registration():
+    """Test what happens when we try to register a blueprint with empty name."""
+    print("\nTesting registration of blueprint with empty name...")
+    
+    try:
+        bp = flask.Blueprint("", __name__)
+        app = flask.Flask(__name__)
+        app.register_blueprint(bp)
+        print("ERROR: Blueprint with empty name was registered successfully!")
+        print(f"Blueprint name: '{bp.name}'")
+        return False
+    except Exception as e:
+        print(f"Registration error (expected): {type(e).__name__}: {e}")
+        return True
+
+if __name__ == "__main__":
+    print("Reproducing Blueprint name validation issue...")
+    
+    result1 = test_empty_blueprint_name()
+    result2 = test_none_blueprint_name()
+    result3 = test_valid_blueprint_name()
+    result4 = test_empty_name_registration()
+    
+    if result1 and result2 and result3 and result4:
+        print("\nAll tests passed - issue is fixed!")
+    else:
+        print("\nSome tests failed - issue still exists!")
