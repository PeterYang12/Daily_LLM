+#!/usr/bin/env python3
+"""
+Additional edge case tests for blueprint name validation.
+"""
+
+import flask
+
+def test_edge_cases():
+    """Test various edge cases for blueprint names."""
+    print("Testing edge cases for blueprint names...")
+    
+    # Test 1: Empty string
+    try:
+        bp = flask.Blueprint("", __name__)
+        print("FAIL: Empty string name should raise ValueError")
+        return False
+    except ValueError as e:
+        if "'name' must not be empty" in str(e):
+            print("PASS: Empty string correctly rejected")
+        else:
+            print(f"FAIL: Wrong error message: {e}")
+            return False
+    except Exception as e:
+        print(f"FAIL: Unexpected exception: {type(e).__name__}: {e}")
+        return False
+    
+    # Test 2: Whitespace-only string
+    try:
+        bp = flask.Blueprint("   ", __name__)
+        print("PASS: Whitespace-only string accepted (this is OK)")
+    except Exception as e:
+        print(f"INFO: Whitespace-only string rejected: {type(e).__name__}: {e}")
+    
+    # Test 3: None value
+    try:
+        bp = flask.Blueprint(None, __name__)
+        print("FAIL: None name should raise TypeError or ValueError")
+        return False
+    except (TypeError, ValueError) as e:
+        print(f"PASS: None name correctly rejected: {type(e).__name__}: {e}")
+    except Exception as e:
+        print(f"INFO: None name caused unexpected exception: {type(e).__name__}: {e}")
+    
+    # Test 4: Valid name
+    try:
+        bp = flask.Blueprint("valid_name", __name__)
+        print("PASS: Valid name accepted")
+    except Exception as e:
+        print(f"FAIL: Valid name rejected: {type(e).__name__}: {e}")
+        return False
+    
+    # Test 5: Name with dots (should still be rejected)
+    try:
+        bp = flask.Blueprint("invalid.name", __name__)
+        print("FAIL: Dot-containing name should raise ValueError")
+        return False
+    except ValueError as e:
+        if "'name' may not contain a dot" in str(e):
+            print("PASS: Dot-containing name correctly rejected")
+        else:
+            print(f"FAIL: Wrong error message: {e}")
+            return False
+    except Exception as e:
+        print(f"FAIL: Unexpected exception: {type(e).__name__}: {e}")
+        return False
+    
+    # Test 6: Name with special characters (should be OK, as long as no dots)
+    try:
+        bp = flask.Blueprint("name-with-special_chars123", __name__)
+        print("PASS: Special characters in name accepted")
+    except Exception as e:
+        print(f"FAIL: Special characters rejected: {type(e).__name__}: {e}")
+        return False
+        
+    # Test 7: Registering blueprint with empty name (should fail early)
+    try:
+        bp = flask.Blueprint("", __name__)
+        app = flask.Flask(__name__)
+        app.register_blueprint(bp)
+        print("FAIL: Empty name blueprint should not be registrable")
+        return False
+    except ValueError as e:
+        if "'name' must not be empty" in str(e):
+            print("PASS: Empty name blueprint correctly rejected at registration")
+        else:
+            print(f"FAIL: Wrong error message: {e}")
+            return False
+    except Exception as e:
+        print(f"FAIL: Unexpected exception during registration: {type(e).__name__}: {e}")
+        return False
+    
+    return True
+
+if __name__ == "__main__":
+    print("Running edge case tests for blueprint name validation...\n")
+    
+    success = test_edge_cases()
+    
+    print(f"\nEdge case tests: {'PASSED' if success else 'FAILED'}")
