+#!/usr/bin/env python3
+"""
+Additional edge case tests for Blueprint name validation.
+"""
+
+import flask
+
+def test_edge_cases():
+    """Test various edge cases for Blueprint names."""
+    print("Testing edge cases for Blueprint names...")
+    
+    # Test cases that should raise ValueError
+    invalid_names = [
+        "",           # Empty string
+        "   ",        # Whitespace only
+        "\t\n\r",     # Various whitespace characters
+        " \t\n\r ",   # Whitespace with spaces
+    ]
+    
+    # Test cases that should work
+    valid_names = [
+        "valid_name",
+        "name_with_underscores",
+        "NameWithCamelCase",
+        "name-with-dashes",
+        "name123",
+        "a",          # Single character
+    ]
+    
+    # Test invalid names
+    for name in invalid_names:
+        try:
+            bp = flask.Blueprint(name, __name__)
+            print(f"ERROR: Blueprint with name '{repr(name)}' should have raised ValueError")
+            return False
+        except ValueError as e:
+            print(f"SUCCESS: Blueprint with name '{repr(name)}' correctly raised ValueError: {e}")
+        except Exception as e:
+            print(f"ERROR: Blueprint with name '{repr(name)}' raised unexpected exception: {e}")
+            return False
+    
+    # Test valid names
+    for name in valid_names:
+        try:
+            bp = flask.Blueprint(name, __name__)
+            print(f"SUCCESS: Blueprint with name '{name}' created successfully")
+        except Exception as e:
+            print(f"ERROR: Blueprint with name '{name}' should have been accepted: {e}")
+            return False
+    
+    return True
+
+def test_blueprint_registration():
+    """Test that valid blueprints can be registered correctly."""
+    print("Testing Blueprint registration with valid names...")
+    
+    try:
+        app = flask.Flask(__name__)
+        bp = flask.Blueprint("test_bp", __name__)
+        
+        @bp.route("/")
+        def index():
+            return "Hello"
+        
+        app.register_blueprint(bp)
+        print("SUCCESS: Valid blueprint registered successfully")
+        
+        # Test that it works
+        with app.test_client() as client:
+            response = client.get("/")
+            if response.data == b"Hello":
+                print("SUCCESS: Blueprint route works correctly")
+                return True
+            else:
+                print(f"ERROR: Blueprint route returned unexpected data: {response.data}")
+                return False
+                
+    except Exception as e:
+        print(f"ERROR: Valid blueprint registration failed: {e}")
+        return False
+
+if __name__ == "__main__":
+    print("Running edge case tests for Blueprint name validation...")
+    print("=" * 60)
+    
+    results = []
+    results.append(test_edge_cases())
+    results.append(test_blueprint_registration())
+    
+    print("=" * 60)
+    if all(results):
+        print("All edge case tests passed!")
+    else:
+        print("Some edge case tests failed!")
