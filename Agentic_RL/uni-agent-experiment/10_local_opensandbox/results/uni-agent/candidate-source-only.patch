+#!/usr/bin/env python3
+"""
+Script to reproduce the issue with empty Blueprint names.
+"""
+
+import flask
+
+def test_empty_blueprint_name():
+    """Test that creating a Blueprint with an empty name raises ValueError."""
+    print("Testing Blueprint with empty name...")
+    
+    try:
+        # This should raise a ValueError according to the issue
+        bp = flask.Blueprint("", __name__)
+        print("ERROR: No exception was raised for empty name!")
+        return False
+    except ValueError as e:
+        print(f"SUCCESS: ValueError raised as expected: {e}")
+        return True
+    except Exception as e:
+        print(f"ERROR: Unexpected exception: {e}")
+        return False
+
+def test_whitespace_blueprint_name():
+    """Test that creating a Blueprint with whitespace-only name raises ValueError."""
+    print("Testing Blueprint with whitespace-only name...")
+    
+    try:
+        # This should also raise a ValueError
+        bp = flask.Blueprint("   ", __name__)
+        print("ERROR: No exception was raised for whitespace-only name!")
+        return False
+    except ValueError as e:
+        print(f"SUCCESS: ValueError raised as expected: {e}")
+        return True
+    except Exception as e:
+        print(f"ERROR: Unexpected exception: {e}")
+        return False
+
+def test_valid_blueprint_name():
+    """Test that creating a Blueprint with a valid name works correctly."""
+    print("Testing Blueprint with valid name...")
+    
+    try:
+        bp = flask.Blueprint("valid_name", __name__)
+        print("SUCCESS: Valid name accepted")
+        return True
+    except Exception as e:
+        print(f"ERROR: Valid name rejected: {e}")
+        return False
+
+def test_strip_whitespace_blueprint_name():
+    """Test that creating a Blueprint with name that becomes empty after stripping raises ValueError."""
+    print("Testing Blueprint with name that becomes empty after stripping...")
+    
+    try:
+        # This should also raise a ValueError
+        bp = flask.Blueprint(" \t\n ", __name__)
+        print("ERROR: No exception was raised for whitespace-only name after stripping!")
+        return False
+    except ValueError as e:
+        print(f"SUCCESS: ValueError raised as expected: {e}")
+        return True
+    except Exception as e:
+        print(f"ERROR: Unexpected exception: {e}")
+        return False
+
+if __name__ == "__main__":
+    print("Reproducing Blueprint name validation issue...")
+    print("=" * 50)
+    
+    results = []
+    results.append(test_empty_blueprint_name())
+    results.append(test_whitespace_blueprint_name())
+    results.append(test_valid_blueprint_name())
+    results.append(test_strip_whitespace_blueprint_name())
+    
+    print("=" * 50)
+    if all(results):
+        print("All tests passed!")
+    else:
+        print("Some tests failed!")
