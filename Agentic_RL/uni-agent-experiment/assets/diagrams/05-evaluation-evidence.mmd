flowchart TB
  DATA["固定SWE-bench Verified数据<br/>预选30题，覆盖12个仓库"] --> CTRL["环境正负控制<br/>原始代码失败 + gold补丁成功"]
  CTRL -->|合格28题| RUN["三种agent各作答一次<br/>同模型、同题集，共84次任务"]
  CTRL -->|未就绪2题| HOLD["单独记录，不补选、不混入能力分母"]
  RUN --> PATCH["保存候选补丁与AgentResult"]
  RUN --> TRACE["Gateway保存token / mask<br/>正式主run未保存logprob"]
  PATCH --> DELTA["统一计算相对镜像初始状态的agent改动<br/>不重新采样模型"]
  DELTA --> TEST["在新建sandbox中应用补丁<br/>运行上游SWE verifier"]
  TEST --> METRIC["resolved / eval_completed / finished<br/>既有测试修改检查 / 剥离测试路径复验"]
  TRACE --> JOIN["按instance和session关联结果与证据"]
  METRIC --> JOIN
  EXTRA["另做三种agent各1次轨迹验证<br/>显式启用logprob保存"] --> JOIN
  JOIN --> REPORT["结果表、案例与可追溯文档<br/>没有执行RL参数更新"]
